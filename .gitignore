.env
.venv/
out/
__pycache__/
.pytest_cache/
*.db
*.pyc
.DS_Store
node_modules/
.DS_Store
# --- release signing (keystore stays out of git — catastrophic if leaked) ---
mobile/android/app/*.jks
mobile/android/app/*.keystore
# --- release build outputs ---
mobile/android/app/build/outputs/apk/release/

# --- secrets (live gateway key MUST stay out of a public repo) ---
secrets/
!secrets/.gitkeep
# --- build/tooling state ---
.gradle-home/
.pytest_cache/
pytest-of-admin/
.agnes/
.venv-filter/
# --- generated release distribution (APKs go to GitHub Releases, not git) ---
dist/
# --- generated mobile data (regenerate: python3 -m dict_factory.export_mobile + sync) ---
mobile/www/data/
mobile/android/app/src/main/assets/public/data/
# --- E2E toolchain (large downloaded browsers + temp profiles) ---
.e2e/browsers/
.e2e/tmp/
.e2e/home*/
.e2e/avdhome/
