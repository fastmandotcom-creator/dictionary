{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "examples_monolingual.v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 40,
  "items": {
    "type": "object",
    "required": ["id", "s"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "s": {
        "type": "object",
        "minProperties": 35,
        "additionalProperties": {"type": "string", "minLength": 2, "maxLength": 240}
      }
    }
  }
}
