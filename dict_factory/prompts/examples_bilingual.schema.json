{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "examples_bilingual.v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 40,
  "items": {
    "type": "object",
    "required": ["id", "st", "sb"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "st": {"type": "string", "minLength": 2, "maxLength": 240},
      "sb": {"type": "string", "minLength": 2, "maxLength": 240}
    }
  }
}
