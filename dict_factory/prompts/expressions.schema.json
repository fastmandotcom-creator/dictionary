{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "expressions.v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 40,
  "items": {
    "type": "object",
    "required": ["id", "langs"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "langs": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "object",
          "required": ["t", "m"],
          "properties": {
            "t": {"type": "string", "minLength": 1, "maxLength": 80},
            "m": {"type": "string", "minLength": 1, "maxLength": 120},
            "k": {
              "type": "string",
              "enum": ["word", "collocation", "verb_expression", "phrasal_verb", "compound_verb", "fixed_expression", "sentence_pattern", "idiom", "phrase"]
            }
          }
        }
      }
    }
  }
}
