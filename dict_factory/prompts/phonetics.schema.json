{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "phonetics.v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 40,
  "items": {
    "type": "object",
    "required": ["id", "ro", "ipa"],
    "properties": {
      "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
      "ro": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z'\\-. ]+$"},
      "ipa": {"type": "string", "minLength": 2, "maxLength": 96}
    }
  }
}
