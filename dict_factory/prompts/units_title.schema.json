{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "units_title.v1",
  "type": "array",
  "minItems": 1,
  "maxItems": 60,
  "items": {
    "type": "object",
    "required": ["order_no", "cefr", "title", "ids"],
    "properties": {
      "order_no": {"type": "integer", "minimum": 1},
      "cefr": {"type": "string", "enum": ["A1", "A2", "B1", "B2", "C1"]},
      "title": {"type": "string", "minLength": 2, "maxLength": 60},
      "ids": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}}
    }
  }
}
